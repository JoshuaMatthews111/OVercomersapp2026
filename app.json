{
  "expo": {
    "name": "Overcomers Global Network",
    "slug": "overcomers-global-network-app",
    "scheme": "ognapp",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/ogn-app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.overcomers.globalnetwork.app",
      "buildNumber": "32",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Overcomers uses your location on the Evangelism map to show where you are, so you can save an outreach area, a visit or a follow-up in the right place.",
        "NSCameraUsageDescription": "Overcomers opens the camera when you tap Camera in a chat, so you can take a photo or a short video and send it to the conversation.",
        "NSMicrophoneUsageDescription": "Overcomers uses the microphone only while you are recording a video with the chat camera, so the video you send has its sound.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDisplayName": "Overcomers",
        "NSMotionUsageDescription": "Overcomers uses motion only to point the compass on the Evangelism map, so the map can turn the way you are facing. It is never recorded or shared."
      }
    },
    "android": {
      "package": "com.overcomers.globalnetwork.app",
      "versionCode": 16,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ogn-adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "./plugins/with-short-app-name",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Overcomers uses your location on the Evangelism map to show where you are, so you can save an outreach area, a visit or a follow-up in the right place.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ogn-logo-transparent.png",
          "resizeMode": "contain",
          "backgroundColor": "#071B45",
          "dark": {
            "image": "./assets/images/ogn-logo-transparent.png",
            "backgroundColor": "#071B45"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Overcomers opens the camera when you tap Camera in a chat, so you can take a photo or a short video and send it to the conversation.",
          "microphonePermission": "Overcomers uses the microphone only while you are recording a video with the chat camera, so the video you send has its sound."
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8e9b3da8-b8dc-4275-a247-e226a4eca99a"
      }
    },
    "owner": "joshflaww",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8e9b3da8-b8dc-4275-a247-e226a4eca99a",
      "fallbackToCacheTimeout": 0
    }
  }
}
